@{
    if (Session["Role"] != null)
    {
        var role = Session["Role"].ToString().ToLower();
        if (role == "admin")
        {
            Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
        }
        else if (role == "giangvien")
        {
            Layout = "~/Views/Shared/_LayoutGiangVien.cshtml";
        }
    }
}

<!-- SweetAlert2 -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.19/dist/sweetalert2.all.min.js"></script>

<h2>Thêm Phòng Học</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="IDPhongHoc">Mã Phòng Học</label>
        <input type="text" id="IDPhongHoc" name="IDPhongHoc" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="TenPhong">Tên Phòng Học</label>
        <input type="text" id="TenPhong" name="TenPhong" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="SucChua">Sức Chứa</label>
        <div class="input-group">
            <button type="button" class="btn btn-secondary" id="decrease" onclick="changeCapacity(-1)">-</button>
            <input type="number" id="SucChua" name="SucChua" class="form-control" value="0" min="0" max="20" required />
            <button type="button" class="btn btn-secondary" id="increase" onclick="changeCapacity(1)">+</button>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Thêm Phòng Học</button>
}

@section Scripts {
    <script>
        function changeCapacity(value) {
            var capacity = parseInt(document.getElementById('SucChua').value) || 0;
            var newCapacity = capacity + value;

            // Giới hạn sức chứa từ 0 đến 20
            if (newCapacity >= 0 && newCapacity <= 20) {
                document.getElementById('SucChua').value = newCapacity;
            }
        }
    </script>
}

<script src="~/Scripts/JSThongBao.js"></script>
@if (ViewBag.ThongBao != null)
{
    <script>
            // Gọi hàm showAlert từ file JSThongBao.js
            showAlert('@Html.Raw(ViewBag.ThongBao)');
    </script>
}
